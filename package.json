{
	"name": "wp-last-login",
	"version": "7.0.0",
	"private": true,
	"description": "Displays the date of the last login in user lists.",
	"author": "Konstantin Obenland",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"users",
		"login",
		"last login"
	],
	"homepage": "https://wordpress.org/plugins/wp-last-login/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/obenland/wp-last-login.git"
	},
	"bugs": {
		"url": "https://github.com/obenland/wp-last-login/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@wordpress/env": "^11.6.0",
		"@wordpress/scripts": "^32.2.0"
	},
	"overrides": {
		"serialize-javascript": "^7.0.5",
		"webpack-dev-server": "^5.2.1",
		"simple-git": "^3.32.3",
		"minimatch@<3.1.3": "^3.1.3",
		"js-yaml@<3.14.2": "^3.14.2",
		"axios": "^1.15.2",
		"@babel/plugin-transform-modules-systemjs": "^7.29.4",
		"fast-xml-builder": "^1.1.7",
		"ip-address": "^10.1.1",
		"basic-ftp": "^5.3.1"
	},
	"scripts": {
		"wp-env": "wp-env",
		"start": "wp-env start",
		"stop": "wp-env stop",
		"destroy": "wp-env destroy",
		"start:tests": "wp-env start --config .wp-env.tests.json",
		"stop:tests": "wp-env stop --config .wp-env.tests.json",
		"destroy:tests": "wp-env destroy --config .wp-env.tests.json",
		"lint": "npm run lint:php && npm run lint:md && npm run lint:pkg-json",
		"lint:fix": "npm run lint:php:fix",
		"lint:php": "node bin/wp-env-run.js cli ./vendor/bin/phpcs",
		"lint:php:fix": "node bin/wp-env-run.js cli ./vendor/bin/phpcbf",
		"lint:md": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"test": "npm run test-php",
		"test-e2e": "wp-scripts test-playwright",
		"test-php": "node bin/wp-env-run.js --config .wp-env.tests.json cli composer test",
		"test-php-multisite": "node bin/wp-env-run.js --config .wp-env.tests.json cli composer test-multisite",
		"test-php-coverage": "node bin/wp-env-run.js --config .wp-env.tests.json cli composer test-coverage",
		"get-coverage": "node bin/get-coverage.js"
	}
}
